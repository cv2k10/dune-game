{
  "name": "dune-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "npm run build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply dune-game-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dune-game-db --remote",
    "deploy": "npm run build && wrangler d1 migrations apply dune-game-db --remote && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.156.0"
  }
}
